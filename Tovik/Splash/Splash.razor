@page "/landing"
@layout SplashLayout

<article>
    <div class="splash-container">
        <div class="tovik-banner">
            <h2>You Need Tovik</h2>
        </div>
        <div class="tovik-laptop">
            <img src="/splash/laptop.svg" />
        </div>
        <div class="tovik-grid__container">
            <div class="tovik-grid">
                <img src="/splash/grid.svg" />
                <ul>
                    <li><span>Instant Language Access</span></li>
                    <li><span>One Click. Many Languages</span></li>
                    <li><span>Expand Your Reach</span></li>
                    <li><span>Easy to Install, Easy to Use</span></li>
                </ul>
            </div>
            <div class="tovik-pencilcup">
                <img src="/splash/pencilcup.svg" />
            </div>
        </div>
        <div class="tovik-btn__container">
            <button><span>Start Tovik</span> <img src="/splash/chevron-right.svg" /></button>
        </div>
    </div>
</article>

