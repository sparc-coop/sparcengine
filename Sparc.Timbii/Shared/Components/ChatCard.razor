<div class="chat-card" @onclick='() => Nav.NavigateTo($"/chats/{Room.RoomId}")'>
    <div class="left">
        <div class="chat-img">
        </div>
        <div class="chat-info">
            <h4>@Room.Name</h4>
            <p>@MessagePreview</p>
        </div>
    </div>
    <div class="right">
        <aside>@DateTimeOffset.FromUnixTimeMilliseconds(Messages.LastOrDefault().OriginServerTs).ToLocalTime().ToString("HH:mm")</aside>
        <div class="notification-bubble">
            <span>1</span> @*number of unread messages*@
        </div>
    </div>
</div>

@code {
    [Parameter] public MatrixRoom Room { get; set; }

    BlossomUser? User { get; set; }
    List<MatrixEvent<Message>> Messages = new List<MatrixEvent<Message>>();
    string? RoomName;
    string? MessagePreview;

    protected override async Task OnInitializedAsync()
    {
        if (Room != null)
        {
            await GetMessagesAsync();
        }

        GetMessagePreview(Messages.LastOrDefault().Content.ToString() ?? string.Empty);
    }

    private async Task GetMessagesAsync()
    {
        Messages = await Chats.GetMessagesAsync(Room!.RoomId);
    }

    public void GetMessagePreview(string message)
    {
        int maxLength = 50;

        if (message.Length <= maxLength)
        {
            MessagePreview = message;
        } else
        {
            MessagePreview = message.Substring(0, maxLength) + "...";
        }
    }
}